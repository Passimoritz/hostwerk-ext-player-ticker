{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "player-ticker",
  "name": {
    "de": "Spieler-Ticker",
    "en": "Player Ticker"
  },
  "description": {
    "de": "Wer ist gerade auf deinen Minecraft-Servern? Live-Liste mit Köpfen, TPS, Spielzeit-Rangliste und Kommen und Gehen – mit Stream-Ansicht für OBS und Discord-Bildschirme.",
    "en": "Who is on your Minecraft servers right now? Live list with heads, TPS, a playtime ranking and who joined or left – with a stream view for OBS and Discord screens."
  },
  "version": "1.3.0",
  "author": "Hostwerk",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-player-ticker",
  "license": "MIT",
  "icon": "icon.svg",
  "banner": "banner.svg",
  "color": "#23964a",
  "category": "games",
  "hostwerk": ">=2.11.0",
  "permissions": [
    "read:services",
    "read:minecraft",
    "storage"
  ],
  "page": {
    "title": {
      "de": "Spieler-Ticker",
      "en": "Player Ticker"
    },
    "icon": "users",
    "file": "page/index.html",
    "description": {
      "de": "Wer ist gerade auf deinen Minecraft-Servern? Live-Liste mit Köpfen, TPS, Spielzeit-Rangliste und Kommen und Gehen – mit Stream-Ansicht für OBS und Discord-Bildschirme.",
      "en": "Who is on your Minecraft servers right now? Live list with heads, TPS, a playtime ranking and who joined or left – with a stream view for OBS and Discord screens."
    },
    "nav": {
      "group": "server",
      "after": "mc",
      "order": 60
    },
    "tabs": [
      {
        "id": "live",
        "title": {
          "de": "Live",
          "en": "Live"
        },
        "icon": "users"
      },
      {
        "id": "events",
        "title": {
          "de": "Kommen und Gehen",
          "en": "Joins and leaves"
        },
        "icon": "clock"
      },
      {
        "id": "stream",
        "title": {
          "de": "Stream-Ansicht",
          "en": "Stream view"
        },
        "icon": "tv"
      }
    ]
  },
  "widget": {
    "title": {
      "de": "Spieler online",
      "en": "Players online"
    },
    "file": "widget/index.html",
    "size": "third"
  },
  "settings": [
    {
      "key": "showOffline",
      "type": "switch",
      "label": {
        "de": "Gestoppte Server zeigen",
        "en": "Show stopped servers"
      },
      "default": true
    },
    {
      "key": "ranking",
      "type": "select",
      "label": {
        "de": "Rangliste",
        "en": "Ranking"
      },
      "default": 3,
      "options": [
        {
          "value": 0,
          "label": {
            "de": "Aus",
            "en": "Off"
          }
        },
        {
          "value": 3,
          "label": {
            "de": "Top 3",
            "en": "Top 3"
          }
        },
        {
          "value": 5,
          "label": {
            "de": "Top 5",
            "en": "Top 5"
          }
        },
        {
          "value": 10,
          "label": {
            "de": "Top 10",
            "en": "Top 10"
          }
        }
      ]
    },
    {
      "key": "refresh",
      "type": "number",
      "label": {
        "de": "Aktualisieren alle … Sekunden",
        "en": "Refresh every … seconds"
      },
      "default": 10,
      "min": 3,
      "max": 120
    },
    {
      "key": "remoteHeads",
      "type": "switch",
      "label": {
        "de": "Echte Skin-Köpfe von mc-heads.net laden (schickt die Spielernamen an diesen Dienst)",
        "en": "Load real skin heads from mc-heads.net (sends the player names to that service)"
      },
      "default": false
    }
  ],
  "settingsTab": "extensions",
  "allowExtensions": {
    "*": [
      "tabs"
    ]
  }
}
