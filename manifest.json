{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "player-ticker",
  "name": {
    "de": "Spieler",
    "en": "Players"
  },
  "description": {
    "de": "Wer gerade auf deinen Minecraft- und Spiele-Servern ist und wer am meisten spielt: Live-Liste mit Köpfen, TPS, Höchststand und Kommen und Gehen, dazu die Bestenliste mit Spielzeit, Abgebautem, Toden und mehr – gesamt, für Woche oder Monat, mit Profilkarte, Abzeichen und Verlauf. Direkt im Reiter „Spieler“ jedes Minecraft-Servers, als Stream-Ansicht für OBS und auf Wunsch als eigene Webseite in deinem Webserver.",
    "en": "Who is on your Minecraft and game servers right now and who plays the most: a live list with heads, TPS, today’s peak and joins and leaves, plus the leaderboard with playtime, mined blocks, deaths and more – all time, for the week or month, with profile card, badges and history. Right in the “Players” tab of every Minecraft server, as a stream view for OBS and, if you like, as an own web page in your web server."
  },
  "version": "2.0.0",
  "author": "Hostwerk",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-player-ticker",
  "license": "MIT",
  "icon": "icon.svg",
  "banner": "banner.svg",
  "color": "#23964a",
  "category": "games",
  "hostwerk": ">=3.0.0",
  "sdkVersion": "3.8",
  "replaces": [
    "player-leaderboard"
  ],
  "permissions": [
    "read:services",
    "read:minecraft",
    "read:games",
    "share:view",
    "storage",
    "native"
  ],
  "backend": "server/index.js",
  "publicView": {
    "file": "page/obs.html",
    "title": {
      "de": "Spieler online (OBS)",
      "en": "Players online (OBS)"
    }
  },
  "page": {
    "title": {
      "de": "Spieler",
      "en": "Players"
    },
    "icon": "users",
    "file": "page/index.html",
    "description": {
      "de": "Wer gerade spielt und wer am meisten spielt – über alle Minecraft- und Spiele-Server.",
      "en": "Who is playing right now and who plays the most – across all Minecraft and game servers."
    },
    "nav": false,
    "tabs": [
      {
        "id": "live",
        "title": {
          "de": "Live",
          "en": "Live"
        },
        "icon": "users"
      },
      {
        "id": "events",
        "title": {
          "de": "Kommen und Gehen",
          "en": "Joins and leaves"
        },
        "icon": "clock"
      },
      {
        "id": "board",
        "title": {
          "de": "Bestenliste",
          "en": "Leaderboard"
        },
        "icon": "trophy"
      },
      {
        "id": "stream",
        "title": {
          "de": "Stream-Ansicht",
          "en": "Stream view"
        },
        "icon": "tv"
      },
      {
        "id": "site",
        "title": {
          "de": "Webseite",
          "en": "Web page"
        },
        "icon": "globe"
      }
    ]
  },
  "widget": {
    "title": {
      "de": "Spieler",
      "en": "Players"
    },
    "file": "widget/index.html",
    "size": "third"
  },
  "settings": [
    {
      "key": "showOffline",
      "type": "switch",
      "label": {
        "de": "Gestoppte Server zeigen",
        "en": "Show stopped servers"
      },
      "default": true
    },
    {
      "key": "ranking",
      "type": "select",
      "label": {
        "de": "Rangliste",
        "en": "Ranking"
      },
      "default": 3,
      "options": [
        {
          "value": 0,
          "label": {
            "de": "Aus",
            "en": "Off"
          }
        },
        {
          "value": 3,
          "label": {
            "de": "Top 3",
            "en": "Top 3"
          }
        },
        {
          "value": 5,
          "label": {
            "de": "Top 5",
            "en": "Top 5"
          }
        },
        {
          "value": 10,
          "label": {
            "de": "Top 10",
            "en": "Top 10"
          }
        }
      ]
    },
    {
      "key": "refresh",
      "type": "number",
      "label": {
        "de": "Aktualisieren alle … Sekunden",
        "en": "Refresh every … seconds"
      },
      "default": 10,
      "min": 3,
      "max": 120
    },
    {
      "key": "remoteHeads",
      "type": "switch",
      "label": {
        "de": "Echte Skin-Köpfe von mc-heads.net laden (schickt die Spielernamen an diesen Dienst)",
        "en": "Load real skin heads from mc-heads.net (sends the player names to that service)"
      },
      "default": false
    },
    {
      "key": "publicView",
      "type": "switch",
      "label": {
        "de": "Stream-Ansicht ohne Anmeldung freigeben (eigene Adresse für OBS – zeigt Spieler- und Servernamen)",
        "en": "Share the stream view without sign-in (own address for OBS – shows player and server names)"
      },
      "default": false
    },
    {
      "key": "boardMetric",
      "type": "select",
      "label": {
        "de": "Bestenliste: Standard-Kennzahl",
        "en": "Leaderboard: default metric"
      },
      "default": "playMs",
      "options": [
        {
          "value": "playMs",
          "label": {
            "de": "Spielzeit",
            "en": "Playtime"
          }
        },
        {
          "value": "sessions",
          "label": {
            "de": "Besuche",
            "en": "Visits"
          }
        },
        {
          "value": "mined",
          "label": {
            "de": "Abgebaut",
            "en": "Mined"
          }
        },
        {
          "value": "deaths",
          "label": {
            "de": "Tode",
            "en": "Deaths"
          }
        },
        {
          "value": "mobKills",
          "label": {
            "de": "Monster besiegt",
            "en": "Mobs killed"
          }
        },
        {
          "value": "playerKills",
          "label": {
            "de": "Spieler besiegt",
            "en": "Players killed"
          }
        },
        {
          "value": "distanceKm",
          "label": {
            "de": "Strecke",
            "en": "Distance"
          }
        },
        {
          "value": "crafted",
          "label": {
            "de": "Hergestellt",
            "en": "Crafted"
          }
        }
      ]
    },
    {
      "key": "boardLimit",
      "type": "select",
      "label": {
        "de": "Bestenliste: Plätze in der Liste",
        "en": "Leaderboard: places in the list"
      },
      "default": 20,
      "options": [
        {
          "value": 10,
          "label": {
            "de": "Top 10",
            "en": "Top 10"
          }
        },
        {
          "value": 20,
          "label": {
            "de": "Top 20",
            "en": "Top 20"
          }
        },
        {
          "value": 50,
          "label": {
            "de": "Top 50",
            "en": "Top 50"
          }
        },
        {
          "value": 100,
          "label": {
            "de": "Top 100",
            "en": "Top 100"
          }
        }
      ]
    },
    {
      "key": "boardPublic",
      "type": "switch",
      "label": {
        "de": "Bestenliste ohne Anmeldung freigeben (eigene Adresse für OBS – zeigt Spielernamen und Werte)",
        "en": "Share the leaderboard without login (own address for OBS – shows player names and values)"
      },
      "default": false
    },
    {
      "key": "sectionLive",
      "type": "switch",
      "label": {
        "de": "Im Reiter „Spieler“ eines Minecraft-Servers: „Gerade online“ zeigen",
        "en": "In the “Players” tab of a Minecraft server: show “Online now”"
      },
      "default": true
    },
    {
      "key": "sectionBoard",
      "type": "switch",
      "label": {
        "de": "Im Reiter „Spieler“ eines Minecraft-Servers: Bestenliste zeigen",
        "en": "In the “Players” tab of a Minecraft server: show the leaderboard"
      },
      "default": true
    },
    {
      "key": "tileBoard",
      "type": "switch",
      "label": {
        "de": "Kachel: die drei Ersten der Bestenliste zeigen",
        "en": "Tile: show the top three of the leaderboard"
      },
      "default": true
    }
  ],
  "settingsTab": "extensions",
  "allowExtensions": {
    "*": [
      "tabs"
    ]
  },
  "contributes": {
    "sections": [
      {
        "id": "online",
        "title": {
          "de": "Gerade online",
          "en": "Online now"
        },
        "icon": "users",
        "on": "mc.players",
        "file": "page/section.html",
        "height": 620,
        "showIf": "sectionLive"
      },
      {
        "id": "board",
        "title": {
          "de": "Bestenliste",
          "en": "Leaderboard"
        },
        "icon": "trophy",
        "on": "mc.players",
        "file": "page/section-board.html",
        "height": 820,
        "showIf": "sectionBoard"
      }
    ]
  }
}
